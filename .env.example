# ── Required ────────────────────────────────────────────────────────────────
# Supabase project (see DEPLOYMENT.md → Supabase → SQL Editor for setup scripts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (image uploads in the CMS)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Optional ────────────────────────────────────────────────────────────────
# Sentry error tracking
VITE_SENTRY_DSN=

# Plausible site analytics (public site)
VITE_PLAUSIBLE_DOMAIN=

# ── E2E portal tests ─────────────────────────────────────────────────────────
# An admin+ test account. When set, `npm run test:e2e` also runs the
# auth-gated portal spec; without them those tests skip gracefully.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# ── notify-contact Edge Function (admin email alerts) ────────────────────────
# These are set on the Supabase side (`supabase secrets set`), not Vite —
# listed here for reference. See supabase/functions/notify-contact/index.ts.
# RESEND_API_KEY=
# NOTIFY_CONTACT_SENDER=
