[TEMPLATE]
# Supabase Configuration
# Get these values from your Supabase project dashboard:
# Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudinary Configuration (REQUIRED — the only image host)
# Get your cloud name from the Cloudinary dashboard (Account → Settings → Cloud name),
# and create an unsigned upload preset in Settings → Upload → Upload presets
# (unsigned = browser uploads work without exposing your API secret).
# The app uploads to and serves images exclusively from Cloudinary.

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset-name

# Optional: Sentry error tracking
# Create a project at https://sentry.io → Settings → Projects → Client Keys (DSN).
# When set, the app captures uncaught exceptions, unhandled rejections and
# ErrorBoundary failures. Leave empty to disable (no Sentry code is loaded).

VITE_SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.us.sentry.io/1234567

# Optional: privacy-friendly site analytics (Plausible — cookie-less, GDPR-friendly)
# Register your site at https://plausible.io and set the domain here.
# When set, the Plausible script loads on the site. Leave empty to disable.

VITE_PLAUSIBLE_DOMAIN=ameb.example.gov.ng

# Optional: E2E test account (used by `npm run test:e2e`)
# Create a dedicated user in Supabase (Authentication → Users) with an admin+
# role, then set these. The portal E2E specs are skipped when they're empty.

E2E_USER_EMAIL=officer@ameb.gov.ng
E2E_USER_PASSWORD=change-me

# Optional: Sentry source-map upload + release tagging (build-time only, CI)
# Lets production stack traces resolve to readable source. Get the token from
# Sentry → Settings → Auth Tokens (scopes: project:releases, project:read).
# VITE_APP_RELEASE stamps every build (e.g. the git SHA) so events are tagged
# per deploy. The Vite plugin is skipped entirely when these aren't set.

SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
VITE_APP_RELEASE=
